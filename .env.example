# Google Analytics 4 — inlinado no bundle em BUILD TIME (prefixo NEXT_PUBLIC_).
# Precisa estar presente durante o `next build`, não só no runtime do container.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# SMTP (OCI Email Delivery). Injetadas pela plataforma 8khost ao rodar
# `8k email:provision institucional --from noreply@8ksoft.com` — em produção
# NAO se preenche à mão. Aqui só para desenvolvimento local.
SMTP_HOST=smtp.email.sa-saopaulo-1.oci.oraclecloud.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@8ksoft.com

# Cloudflare Turnstile (captcha do formulário de contato).
# Site key é pública e vai no bundle; a secret key é só de servidor.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
